# Local development configuration for the PID issuer.
#
# Rendered at container start by docker/entrypoint.sh, which substitutes the
# placeholders below from the environment (compose passes them in). The app's
# own loader does no variable expansion, so this file is a template, not the
# config the app reads.
#
# Everything here is test material. The keys and certificates it points at come
# from the EU reference test PKI shipped in api_docs/test_tokens/ and are laid
# out by dev-ca/bootstrap-pki.sh. No real credential is referenced, which is why
# unlike config_issuer_backend.yaml this file is safe to commit.

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
service_url: "${ISSUER_PUBLIC_URL}"

wallet_tester_url: "${ISSUER_PUBLIC_URL}"

revocation:
  take_url: "${STATUSLIST_PUBLIC_URL}/token_status_list/take"
  set_url: ${STATUSLIST_PUBLIC_URL}/token_status_list/set
  api_key: "test"  # SECRET
  enabled: true

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
frontend:
  default: "5d725b3c-6d42-448e-8bfd-1eff1fcf152d"

  frontends_config:
    "5d725b3c-6d42-448e-8bfd-1eff1fcf152d":
      url: "${FRONTEND_PUBLIC_URL}"
      metadata_signing_key_path: "/etc/eudiw/pid-issuer-dev/privKey/PID-DS-0002_EU.pem"
      metadata_access_certificate_path: "/etc/eudiw/pid-issuer-dev/cert/PID-DS-0002_EU_cert.pem"
      # Null because pki/bootstrap.sh decrypts the shipped test key: the app
      # passes this value straight to load_pem_private_key(), which wants bytes
      # rather than the string YAML gives it.
      metadata_signing_key_password: null

# ============================================================================
# ISSUER AUTHORIZATION SERVER CONFIGURATION
# ============================================================================

authorization_server:
  # Two URLs on purpose, because there are two kinds of caller.
  #
  # base_url is what the *wallet/browser* is redirected to, so it must be
  # reachable from outside the compose network and is what appears in the
  # published issuer metadata.
  #
  # internal_url is what this container uses for server-to-server calls
  # (/introspection, /verify/user, preauthorization). It resolves over the
  # compose network to the oidc service, which is why the dev CA issues that
  # leaf with a SAN for the service name as well as localhost.
  #
  # The app already prefers internal_url and falls back to base_url
  # (app/route_oidc.py:295), it was simply never set. Without it the issuer
  # would dial its own localhost and only appear to work because those calls
  # pass verify=False.
  base_url: "${OIDC_PUBLIC_URL}"
  internal_url: "${OIDC_INTERNAL_URL}"
  user_verify_endpoint: "${OIDC_INTERNAL_URL}/verify/user"

# ============================================================================
# EXTERNAL SERVICES CONFIGURATION
# ============================================================================
#verifier url for oid4vp request generation, available at https://github.com/eu-digital-identity-wallet/eudi-srv-verifier-endpoint
dynamic_presentation_url: "https://verifier-backend.eudiw.dev/ui/presentations"

# WUA trust validator url, available at https://github.com/eu-digital-identity-wallet/eudi-srv-trust-validator
trust_validator:
  url: "https://trust-validator.eudiw.dev/trust"
  enabled: true

# ============================================================================
# SCHEMA CONFIGURATION
# ============================================================================
oid4vp_scheme: "haip-vp://"

credential_offer_scheme: "haip-vci://"

# ============================================================================
# LOGGING
# ============================================================================
logging:
  backend_path: "/tmp/log_dev/logs.log"
  log_level: "INFO"

# ============================================================================
# EXPIRY TIMES (minutes)
# ============================================================================
expiry:
  revocation_code: 60
  form: 60
  session: 60

# ============================================================================
# KEY PATHS
# ============================================================================
keys:
  nonce_path: "/etc/eudiw/pid-issuer-dev/privKey/private_nonce_key.pem" # Private key that signs the nonce at the nonce enpoint.
  credential_request_path: "/etc/eudiw/pid-issuer-dev/privKey/credential_request.pem" # Private key used for credential request encryption. Metadata advertised public key is automatically generated from this private key.

# Path to trusted CA certificates, used to validate VP_Tokens
trusted_CAs_path: "/etc/eudiw/pid-issuer-dev/cert/"

# ============================================================================
# CREDENTIALS AUTHENTICATION METHODS CONFIGURATION
# ============================================================================
credential_auth_methods:
