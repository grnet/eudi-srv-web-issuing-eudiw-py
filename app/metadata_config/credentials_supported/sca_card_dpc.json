{
   "eu.webuildconsortium.sca.card_dpc_sd_jwt":{
      "format":"dc+sd-jwt",
      "vct":"https://issuer.bank.example/credentials/sca/card-dpc/1.0",
      "scope":"eu.webuildconsortium.sca.card_dpc_sd_jwt",
      "cryptographic_binding_methods_supported":[
         "jwk"
      ],
      "credential_signing_alg_values_supported":[
         "ES256"
      ],
      "proof_types_supported":{
         "jwt":{
            "proof_signing_alg_values_supported":[
               "ES256"
            ]
         }
      },
      "credential_metadata":{
         "display":[
            {
               "name":"SCA Card (DPC)",
               "locale":"en",
               "description":"Digital Payment Credential for payment authentication with Strong Customer Authentication.",
               "logo":{
                  "uri":"https://issuer.bank.example/assets/sca-card-logo.png",
                  "alt_text":"SCA Card (DPC) credential logo"
               },
               "background_color":"#1A3C8F",
               "text_color":"#FFFFFF"
            }
         ],
         "claims":[
            {
               "path":[
                  "credential_id"
               ],
               "mandatory":true,
               "value_type":"string",
               "source":"issuer",
               "display":[
                  {
                     "name":"Credential ID",
                     "locale":"en"
                  }
               ]
            },
            {
               "path":[
                  "network"
               ],
               "mandatory":true,
               "value_type":"string",
               "source":"user",
               "display":[
                  {
                     "name":"Payment Network",
                     "locale":"en"
                  }
               ]
            },
            {
               "path":[
                  "card_id"
               ],
               "mandatory":false,
               "value_type":"string",
               "source":"user",
               "display":[
                  {
                     "name":"Card ID",
                     "locale":"en"
                  }
               ]
            },
            {
               "path":[
                  "attestation_legal_category"
               ],
               "mandatory":true,
               "source":"issuer",
               "display":[
                  {
                     "name":"Attestation Legal Category",
                     "locale":"en"
                  }
               ]
            }
         ]
      },
      "issuer_config":{
         "issuing_authority":"Test SCA issuer",
         "organization_id":"EUDI Wallet Reference Implementation",
         "validity":730,
         "organization_name":"Test SCA issuer"
      }
   }
}
