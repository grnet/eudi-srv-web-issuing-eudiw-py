{
  "eu.europa.ec.eudiw.mvrc.delegation_permission_mdoc":{
    "format":"mso_mdoc",
    "doctype":"eu.europa.ec.eudiw.mvrc.delegation_permission.1",
    "scope":"eu.europa.ec.eudiw.mvrc.delegation_permission_mdoc",
    "policy":{
      "batch_size":1,
      "one_time_use":true
    },
    "cryptographic_binding_methods_supported":[
      "jwk",
      "cose_key"
    ],
    "credential_signing_alg_values_supported":[
      -7
    ],
    "proof_types_supported":{
      "jwt":{
        "proof_signing_alg_values_supported":[
          "ES256",
          "ES384",
          "ES512"
        ],
        "key_attestations_required":{
          "key_storage":[
            "iso_18045_high"
          ],
          "user_authentication":[
            "iso_18045_high"
          ],
          "preferred_key_storage_status_period":2678400
        }
      },
      "attestation":{
        "proof_signing_alg_values_supported":[
          "ES256",
          "ES384",
          "ES512"
        ],
        "key_attestations_required":{
          "key_storage":[
            "iso_18045_high"
          ],
          "user_authentication":[
            "iso_18045_high"
          ],
          "preferred_key_storage_status_period":2678400
        }
      }
    },
    "credential_metadata":{
      "display":[
        {
          "name":"mVRC Delegation Permission (MSO Mdoc)",
          "locale":"en",
          "logo":{
            "uri":"https://examplestate.com/public/mvc.png",
            "alt_text":"A square figure of a Mobile Vehicle Registration Certificate"
          }
        }
      ],
      "credential_reuse_policy":{
        "id":"arf_annex_ii",
        "options":[
          {
            "details":[
              "once_only"
            ],
            "batch_size":30,
            "reissue_trigger_unused":3
          }
        ]
      },
      "claims":[
        {
          "path":[
            "eu.europa.ec.eudiw.mvrc.delegation_permission.1",
            "delegation_permission_id"
          ],
          "mandatory":true,
          "value_type":"string",
          "source":"user",
          "display":[
            {
              "name":"Delegation Permission ID",
              "locale":"en"
            }
          ]
        },
        {
          "path":[
            "eu.europa.ec.eudiw.mvrc.delegation_permission.1",
            "vehicle_identification_number"
          ],
          "mandatory":true,
          "value_type":"string",
          "source":"user",
          "display":[
            {
              "name":"Vehicle Identification Number",
              "locale":"en"
            }
          ]
        },
        {
          "path":[
            "eu.europa.ec.eudiw.mvrc.delegation_permission.1",
            "vehicle_registration_number"
          ],
          "mandatory":true,
          "value_type":"string",
          "source":"user",
          "display":[
            {
              "name":"Vehicle Registration Number",
              "locale":"en"
            }
          ]
        },
        {
          "path":[
            "eu.europa.ec.eudiw.mvrc.delegation_permission.1",
            "vehicle_privileges"
          ],
          "mandatory":true,
          "value_type":"vehicle_privileges_attributes",
          "source":"user",
          "display":[
            {
              "name":"Vehicle Privileges",
              "locale":"en"
            }
          ],
          "issuer_conditions":{
            "cardinality":{
              "min":1,
              "max":1
            },
            "vehicle_privileges_attributes":{
              "privileges_scope":{
                "mandatory":true,
                "value_type":"string",
                "source":"user",
                "options":[
                  "full",
                  "partial"
                ]
              },
              "partial_privileges":{
                "mandatory":false,
                "value_type":"list_string",
                "source":"user",
                "options":[
                  "drive",
                  "road_suitability",
                  "id_plate",
                  "technical_properties"
                ]
              }
            }
          }
        },
        {
          "path":[
            "eu.europa.ec.eudiw.mvrc.delegation_permission.1",
            "expiration_date_time"
          ],
          "mandatory":true,
          "value_type":"string",
          "source":"user",
          "display":[
            {
              "name":"Expiration Date and Time of the Delegated mVRC",
              "locale":"en"
            }
          ]
        },
        {
          "path":[
            "eu.europa.ec.eudiw.mvrc.delegation_permission.1",
            "issuing_organization"
          ],
          "mandatory":true,
          "value_type":"string",
          "source":"user",
          "display":[
            {
              "name":"Issuing Organization",
              "locale":"en"
            }
          ]
        }
      ]
    },
    "issuer_config":{
      "issuing_authority":"Test QEAA Issuer",
      "organization_id":"EUDI Wallet Reference Implementation",
      "validity":1,
      "organization_name":"Test QEAA Issuer",
      "namespace":"eu.europa.ec.eudiw.mvrc.delegation_permission.1"
    }
  }
}