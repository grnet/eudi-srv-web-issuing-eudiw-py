# Copy to .env and adjust. Every value has a working default in compose.yaml,
# so .env is only needed when a port is already taken locally.

# Host ports. Change these if something already listens on 5600/5601 locally.
ISSUER_PORT=5600
OIDC_PORT=5601

# Not in this stack yet, but the issuer's metadata advertises these URLs, so
# they are configurable ahead of the services existing.
FRONTEND_PORT=5602
STATUSLIST_PORT=5603

# Flask reloader. 0 for quieter logs.
FLASK_DEBUG=1
