# Non-secret deploy configuration, committed so it is reviewable in a diff.
# Secrets are repository secrets, listed in deploy/README.md.

ISSUER_HOST=demo.eudiw.grnet.gr

# Paths on the one hostname that exists. No DNS records have been created, so
# every service shares demo.eudiw.grnet.gr and is told apart by prefix.
ISSUER_PATH=/issuer/
OIDC_PATH=/auth/

# What the issuer publishes. Every absolute URL it emits is this plus a path,
# and it rewrites its own metadata at startup by substituting this for the
# credential_issuer value baked into app/metadata_config/*.json. No trailing
# slash: the code concatenates "/..." onto it.
ISSUER_PUBLIC_URL=https://demo.eudiw.grnet.gr/issuer

# Two URLs for the authorization server, on purpose.
#
# base_url is where the browser is redirected and what appears in published
# metadata, so it has to resolve from outside.
#
# internal_url is the issuer's server-to-server hop for /introspection
# (app/route_oidc.py:297). Plain http and a container name: the OIDC server has
# its ssl_context commented out upstream and serves http, so this cannot be
# https. Without it the issuer would dial its own public URL and go out through
# the proxy and back.
OIDC_PUBLIC_URL=https://demo.eudiw.grnet.gr/auth
OIDC_INTERNAL_URL=http://oidc:5000

# Our frontend, deployed from eudi-srv-web-issuing-frontend-eudiw-py. It is a
# distinct credential issuer identity: the backend signs metadata on its behalf,
# keyed by the frontend_id in frontends_config.
FRONTEND_PUBLIC_URL=https://demo.eudiw.grnet.gr/frontend

# The containerised status list, on 443 with no port.
STATUSLIST_PUBLIC_URL=https://demo.eudiw.grnet.gr

LETSENCRYPT_EMAIL=devops-rnd@grnet.gr

# No key path here on purpose. The document-signing material is unpacked into a
# named volume by the pki-init container, from archives that ship in the image,
# so nothing has to be placed on the box by hand.
